# RadioScribe AI Engine — Environment Variables
# Copy this file to .env and fill in your values

# Local inference configuration
LOCAL_LLM_PROVIDER=mock
LOCAL_TEXT_MODEL_NAME=llama3:8b-instruct-q4_K_M
LOCAL_VISION_MODEL_NAME=llava:7b-v1.6-mistral-q4_K_M
LOCAL_EMBEDDING_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
LOCAL_EMBEDDING_DIM=768
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=45

# Supabase Database (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
